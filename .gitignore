# --- Python / FastAPI general ignores ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
*.log
*.sqlite3
.env
.env.*
.venv/
venv/
.idea/
.vscode/
*.DS_Store

# --- Bytecode / cache ---
*.pyc
*.pkl
*.mypy_cache/
*.pytest_cache/

# --- Build artifacts ---
dist/
build/
*.spec

# --- Media uploads (keep folder, ignore contents) ---
media/*
!media/.gitkeep

# --- Local data ---
data/
tmp/
logs/
