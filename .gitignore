# --- Python / FastAPI general ignores ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
*.log
*.sqlite3
.env
.env.*
.venv/
venv/
.idea/
.vscode/
*.DS_Store

# --- Bytecode / cache ---
*.pyc
*.pkl
*.mypy_cache/
*.pytest_cache/

# --- Build artifacts ---
dist/
build/
*.spec

# --- Media uploads (ignore all contents recursively) ---
backend/media/**
!backend/media/.gitkeep

# --- Local data ---
data/
tmp/
logs/

# --- FAISS index files ---
*.index
*.meta.json
faiss.index
faiss.meta.json
